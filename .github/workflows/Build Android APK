
name: Build Android APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: List project files
        run: |
          echo "Repository files:"
          ls -la
          echo "Checking project configuration:"
          test -f package.json && cat package.json || echo "package.json is missing"
          test -f capacitor.config.json && cat capacitor.config.json || echo "capacitor.config.json is missing"
